// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  OWNERS_EQUITY
  OPERATING_REVENUE
  OTHER_INCOME
  COST_OF_SERVICES
  OPERATING_EXPENSE
  OTHER_EXPENSE
}

model Account {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  type          AccountType
  subType       AccountSubType
  normalBalance NormalBalance
  isPostable    Boolean        @default(true)
  isActive      Boolean        @default(true)
  lines         JournalLine[]

  parentId      String?
  parent        Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]      @relation("AccountHierarchy")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type])
  @@index([parentId])
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id           String        @id @default(cuid())
  entryNumber  Int           @unique
  entryDate    DateTime      @db.Date
  serviceDate  DateTime?     @db.Date
  description  String
  status       EntryStatus   @default(DRAFT)
  postedAt     DateTime?

  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("EntryReversal")

  lines        JournalLine[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([entryDate])
  @@index([status])
}

model JournalLine {
  id           String       @id @default(cuid())

  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])

  lineNumber   Int
  description  String?

  debit        Decimal      @default(0) @db.Decimal(12, 2)
  credit       Decimal      @default(0) @db.Decimal(12, 2)

  currency     String       @default("CAD")
  exchangeRate Decimal      @default(1) @db.Decimal(18, 8)

  @@unique([entryId, lineNumber])
  @@index([accountId])
  @@index([entryId])
}