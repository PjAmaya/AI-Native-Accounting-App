// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  OWNERS_EQUITY
  OPERATING_REVENUE
  OTHER_INCOME
  COST_OF_SERVICES
  OPERATING_EXPENSE
  OTHER_EXPENSE
}

model Account {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  type          AccountType
  subType       AccountSubType
  normalBalance NormalBalance
  isPostable    Boolean        @default(true)
  isActive      Boolean        @default(true)
  capitalCandidate Boolean     @default(false)
  ebitdaAddBack EbitdaAddBack  @default(NONE)
  lines         JournalLine[]
  taxCollectedFor   TaxRate[]     @relation("TaxCollected")
  taxRecoverableFor TaxRate[]     @relation("TaxRecoverable")
  invoiceLines      InvoiceLine[] @relation("InvoiceLineRevenue")
  receivableFor     Contact[]     @relation("ContactReceivable")
  receivableForInvoices Invoice[] @relation("InvoiceReceivable")
  receivableForCredits  CreditNote[] @relation("CreditNoteReceivable")
  creditNoteLines       CreditNoteLine[] @relation("CreditNoteLineRevenue")
  paymentsReceived  Payment[]     @relation("PaymentBankAccount")
  billLines         BillLine[]    @relation("BillLineExpense")
  projectBudgetLines ProjectBudgetLine[]
  supplierCreditLines SupplierCreditLine[] @relation("SupplierCreditLineExpense")

  parentId      String?
  parent        Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]      @relation("AccountHierarchy")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type])
  @@index([parentId])
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id           String        @id @default(cuid())
  entryNumber  Int           @unique
  entryDate    DateTime      @db.Date
  serviceDate  DateTime?     @db.Date
  description  String
  status       EntryStatus   @default(DRAFT)
  postedAt     DateTime?

  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("EntryReversal")

  lines        JournalLine[]
  invoice      Invoice?
  payment      Payment?
  bill         Bill?
  supplierCredit SupplierCredit?
  refundForSupplierCredit SupplierCredit? @relation("SupplierCreditRefund")
  creditNote   CreditNote?
  refundForCredit CreditNote? @relation("CreditNoteRefund")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([entryDate])
  @@index([status])
}

model JournalLine {
  id           String       @id @default(cuid())

  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])

  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id])

  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  
  lineNumber   Int
  description  String?

  debit        Decimal      @default(0) @db.Decimal(12, 2)
  credit       Decimal      @default(0) @db.Decimal(12, 2)

  currency     String       @default("CAD")
  exchangeRate Decimal      @default(1) @db.Decimal(18, 8)

  @@unique([entryId, lineNumber])
  @@index([accountId])
  @@index([entryId])
  @@index([contactId])
  @@index([projectId])
}
model Contact {
  id               String        @id @default(cuid())
  name             String
  isCustomer       Boolean       @default(false)
  isVendor         Boolean       @default(false)
  isActive         Boolean       @default(true)

  email            String?
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  province         String?
  postalCode       String?
  country          String        @default("CA")

  dedupeKey        String?       @unique

  receivableAccountId String?
  receivableAccount   Account?   @relation("ContactReceivable", fields: [receivableAccountId], references: [id])

  businessNumber   String?
  isHstRegistered  Boolean       @default(false)
  paymentTermsDays Int           @default(30)
  notes            String?

  lines            JournalLine[]
  projects         Project[]
  invoices         Invoice[]
  payments         Payment[]
  bills            Bill[]
  supplierCredits  SupplierCredit[]
  creditNotes      CreditNote[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isCustomer])
  @@index([isVendor])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String

  contactId   String?
  contact     Contact?      @relation(fields: [contactId], references: [id])

  status      ProjectStatus @default(ACTIVE)
  scope       String?
  driveFolderId String?
  driveFolderUrl String?
  closureReason String?
  closedAt    DateTime?     @db.Date

  contractValue Decimal?    @db.Decimal(12, 2)
  budgetLines   ProjectBudgetLine[]
  attachments   Attachment[]

  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  notes       String?

  lines       JournalLine[]
  invoices    Invoice[]
  bills       Bill[]
  billLines   BillLine[] @relation("BillLineProject")
  supplierCreditLines SupplierCreditLine[] @relation("SupplierCreditLineProject")
  creditNoteLines CreditNoteLine[] @relation("CreditNoteLineProject")
  invoiceLines InvoiceLine[] @relation("InvoiceLineProject")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contactId])
}

model TaxRate {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  ratePercent   Decimal       @db.Decimal(6, 4)
  isActive      Boolean       @default(true)
  effectiveFrom DateTime      @db.Date

  collectedAccountId   String
  collectedAccount     Account @relation("TaxCollected", fields: [collectedAccountId], references: [id])

  recoverableAccountId String
  recoverableAccount   Account @relation("TaxRecoverable", fields: [recoverableAccountId], references: [id])

  invoiceLines  InvoiceLine[]
  creditNoteLines CreditNoteLine[]
  billLines     BillLine[]
  supplierCreditLines SupplierCreditLine[] @relation("SupplierCreditLineTax")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  REFUNDED
  VOID
}

model CreditNote {
  id             String        @id @default(cuid())
  creditNumber   String        @unique
  status         CreditNoteStatus @default(DRAFT)

  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])

  originalInvoiceId String?
  originalInvoice   Invoice?   @relation("CreditNoteOriginal", fields: [originalInvoiceId], references: [id])

  creditDate     DateTime      @db.Date
  reason         String
  notes          String?

  currency       String        @default("CAD")
  exchangeRate   Decimal       @default(1) @db.Decimal(18, 8)

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)

  receivableAccountId String?
  receivableAccount   Account?  @relation("CreditNoteReceivable", fields: [receivableAccountId], references: [id])

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  issuedAt       DateTime?
  refundedAt     DateTime?
  refundEntryId  String?       @unique
  refundEntry    JournalEntry? @relation("CreditNoteRefund", fields: [refundEntryId], references: [id])
  pdfPath        String?
  pdfHash        String?

  lines          CreditNoteLine[]
  applications   CreditApplication[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([contactId])
  @@index([status])
  @@index([creditDate])
}

model CreditNoteLine {
  id          String   @id @default(cuid())

  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  lineNumber  Int
  description String
  amount      Decimal  @db.Decimal(12, 2)

  revenueAccountId String
  revenueAccount   Account @relation("CreditNoteLineRevenue", fields: [revenueAccountId], references: [id])

  projectId   String?
  project     Project? @relation("CreditNoteLineProject", fields: [projectId], references: [id])

  taxRateId   String?
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([creditNoteId, lineNumber])
  @@index([creditNoteId])
}

model CreditApplication {
  id            String   @id @default(cuid())

  creditNoteId  String
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])

  amountApplied Decimal  @db.Decimal(12, 2)
  appliedAt     DateTime @default(now())

  @@unique([creditNoteId, invoiceId])
  @@index([creditNoteId])
  @@index([invoiceId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(DRAFT)

  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])

  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])

  invoiceDate    DateTime      @db.Date
  dueDate        DateTime      @db.Date
  servicePeriodStart DateTime? @db.Date
  servicePeriodEnd   DateTime? @db.Date

  clientReference String?
  notes           String?

  currency       String        @default("CAD")
  exchangeRate   Decimal       @default(1) @db.Decimal(18, 8)

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)

  receivableAccountId String?
  receivableAccount   Account?  @relation("InvoiceReceivable", fields: [receivableAccountId], references: [id])

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  issuedAt       DateTime?
  pdfPath        String?
  pdfHash        String?

  lines          InvoiceLine[]
  applications   PaymentApplication[]
  creditApplications CreditApplication[]
  creditNotes    CreditNote[]  @relation("CreditNoteOriginal")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([contactId])
  @@index([projectId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceLine {
  id          String   @id @default(cuid())

  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  lineNumber  Int
  description String

  quantity    Decimal? @db.Decimal(12, 4)
  unitRate    Decimal? @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  revenueAccountId String
  revenueAccount   Account @relation("InvoiceLineRevenue", fields: [revenueAccountId], references: [id])

  projectId   String?
  project     Project? @relation("InvoiceLineProject", fields: [projectId], references: [id])

  taxRateId   String?
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
}

enum PaymentDirection {
  RECEIVED
  SENT
}

model Payment {
  id             String               @id @default(cuid())
  paymentNumber  Int                  @unique
  direction      PaymentDirection

  contactId      String
  contact        Contact              @relation(fields: [contactId], references: [id])

  paymentDate    DateTime             @db.Date
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("CAD")
  exchangeRate   Decimal              @default(1) @db.Decimal(18, 8)

  bankAccountId  String
  bankAccount    Account              @relation("PaymentBankAccount", fields: [bankAccountId], references: [id])

  method         String?
  reference      String?
  notes          String?

  journalEntryId String?              @unique
  journalEntry   JournalEntry?        @relation(fields: [journalEntryId], references: [id])

  applications   PaymentApplication[]
  billApplications BillApplication[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([contactId])
  @@index([paymentDate])
  @@index([direction])
}

model PaymentApplication {
  id            String   @id @default(cuid())

  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])

  amountApplied Decimal  @db.Decimal(12, 2)
  appliedAt     DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
}

enum BillStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

model Bill {
  id                    String            @id @default(cuid())
  billNumber            Int               @unique
  supplierInvoiceNumber String
  status                BillStatus        @default(DRAFT)

  contactId             String
  contact               Contact           @relation(fields: [contactId], references: [id])

  projectId             String?
  project               Project?          @relation(fields: [projectId], references: [id])

  billDate              DateTime          @db.Date
  dueDate               DateTime          @db.Date
  servicePeriodStart    DateTime?         @db.Date
  servicePeriodEnd      DateTime?         @db.Date

  notes                 String?
  currency              String            @default("CAD")
  exchangeRate          Decimal           @default(1) @db.Decimal(18, 8)

  subtotal              Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal              Decimal           @default(0) @db.Decimal(12, 2)
  total                 Decimal           @default(0) @db.Decimal(12, 2)

  journalEntryId        String?           @unique
  journalEntry          JournalEntry?     @relation(fields: [journalEntryId], references: [id])

  approvedAt            DateTime?
  warnings              String[]
  documentPath          String?
  documentHash          String?

  lines                 BillLine[]
  applications          BillApplication[]
  attachments   Attachment[]
  supplierCreditApplications SupplierCreditApplication[]
  supplierCredits       SupplierCredit[] @relation("SupplierCreditOriginal")

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([contactId, supplierInvoiceNumber])
  @@index([contactId])
  @@index([projectId])
  @@index([status])
  @@index([billDate])
}

model BillLine {
  id             String   @id @default(cuid())

  billId         String
  bill           Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  lineNumber     Int
  description    String

  quantity       Decimal? @db.Decimal(12, 4)
  unitRate       Decimal? @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)

  expenseAccountId String
  expenseAccount   Account @relation("BillLineExpense", fields: [expenseAccountId], references: [id])

  projectId      String?
  project        Project? @relation("BillLineProject", fields: [projectId], references: [id])

  taxRateId      String?
  taxRate        TaxRate? @relation(fields: [taxRateId], references: [id])
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([billId, lineNumber])
  @@index([billId])
}

model BillApplication {
  id            String   @id @default(cuid())

  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])

  amountApplied Decimal  @db.Decimal(12, 2)
  appliedAt     DateTime @default(now())

  @@unique([paymentId, billId])
  @@index([paymentId])
  @@index([billId])
}

model OrgProfile {
  id                  String    @id @default("default")

  legalName           String
  tradeName           String?
  email               String?
  phone               String?

  addressLine1        String?
  addressLine2        String?
  city                String?
  province            String?
  postalCode          String?
  country             String    @default("CA")

  businessNumber      String?
  hstRegisteredFrom   DateTime? @db.Date
  softLockThrough     DateTime? @db.Date
  hardLockThrough     DateTime? @db.Date

  logoPath            String?
  paymentInstructions String?
  invoiceFooter       String?

  googleRefreshToken    String?
  googleAccessToken     String?
  googleTokenExpiresAt  DateTime?

  driveProjectsRootId   String?
  driveFinancialRootId  String?
  driveArInvoicesId     String?
  driveApBillsId        String?
  driveCreditNotesId    String?
  driveSupplierCreditsId String?

  capitalizationThreshold Decimal @default(500) @db.Decimal(12, 2)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum EbitdaAddBack {
  NONE
  DEPRECIATION
  AMORTIZATION
  INTEREST
  INCOME_TAX
}

enum PeriodLockAction {
  SOFT_LOCK_SET
  SOFT_LOCK_RELEASED
  HARD_LOCK_SET
  SOFT_LOCK_OVERRIDE
}

model PeriodLockEvent {
  id           String           @id @default(cuid())
  action       PeriodLockAction
  previousDate DateTime?        @db.Date
  newDate      DateTime?        @db.Date
  entryDate    DateTime?        @db.Date
  reason       String
  performedBy  String
  createdAt    DateTime         @default(now())

  @@index([createdAt])
  @@index([action])
}


enum SupplierCreditStatus {
  DRAFT
  APPROVED
  APPLIED
  REFUNDED
  VOID
}

model SupplierCredit {
  id             String        @id @default(cuid())
  creditNumber   Int           @unique
  supplierCreditNumber String
  status         SupplierCreditStatus @default(DRAFT)

  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])

  originalBillId String?
  originalBill   Bill?         @relation("SupplierCreditOriginal", fields: [originalBillId], references: [id])

  creditDate     DateTime      @db.Date
  reason         String
  notes          String?

  currency       String        @default("CAD")
  exchangeRate   Decimal       @default(1) @db.Decimal(18, 8)

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)

  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  approvedAt     DateTime?
  refundedAt     DateTime?
  refundEntryId  String?       @unique
  refundEntry    JournalEntry? @relation("SupplierCreditRefund", fields: [refundEntryId], references: [id])

  lines          SupplierCreditLine[]
  applications   SupplierCreditApplication[]
  attachments   Attachment[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([contactId, supplierCreditNumber])
  @@index([contactId])
  @@index([status])
  @@index([creditDate])
}

model SupplierCreditLine {
  id          String   @id @default(cuid())

  supplierCreditId String
  supplierCredit   SupplierCredit @relation(fields: [supplierCreditId], references: [id], onDelete: Cascade)

  lineNumber  Int
  description String
  amount      Decimal  @db.Decimal(12, 2)

  expenseAccountId String
  expenseAccount   Account @relation("SupplierCreditLineExpense", fields: [expenseAccountId], references: [id])

  projectId   String?
  project     Project? @relation("SupplierCreditLineProject", fields: [projectId], references: [id])

  taxRateId   String?
  taxRate     TaxRate? @relation("SupplierCreditLineTax", fields: [taxRateId], references: [id])
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([supplierCreditId, lineNumber])
  @@index([supplierCreditId])
}

model SupplierCreditApplication {
  id            String   @id @default(cuid())

  supplierCreditId String
  supplierCredit   SupplierCredit @relation(fields: [supplierCreditId], references: [id], onDelete: Cascade)

  billId        String
  bill          Bill     @relation(fields: [billId], references: [id])

  amountApplied Decimal  @db.Decimal(12, 2)
  appliedAt     DateTime @default(now())

  @@unique([supplierCreditId, billId])
  @@index([supplierCreditId])
  @@index([billId])
}


model ProjectBudgetLine {
  id        String   @id @default(cuid())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  accountId String
  account   Account  @relation(fields: [accountId], references: [id])

  amount    Decimal  @db.Decimal(12, 2)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, accountId])
  @@index([projectId])
}


enum AttachmentKind {
  SERVICE_AGREEMENT
  MILESTONE
  SHARED_DOCUMENT
  SOURCE_DOCUMENT
  SUPPORTING
}

model Attachment {
  id           String         @id @default(cuid())

  kind         AttachmentKind @default(SUPPORTING)
  fileName     String
  mimeType     String
  byteSize     Int
  storagePath  String
  sha256       String

  driveFileId  String?
  driveWebLink String?
  driveSyncedAt DateTime?
  driveError   String?

  description  String?
  uploadedBy   String?

  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  billId       String?
  bill         Bill?          @relation(fields: [billId], references: [id], onDelete: Cascade)

  supplierCreditId String?
  supplierCredit   SupplierCredit? @relation(fields: [supplierCreditId], references: [id], onDelete: Cascade)

  createdAt    DateTime       @default(now())

  @@index([projectId])
  @@index([billId])
  @@index([supplierCreditId])
  @@index([sha256])
}
